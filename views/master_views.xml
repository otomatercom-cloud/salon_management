<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customers -->
    <record id="view_partner_form_salon" model="ir.ui.view">
        <field name="name">res.partner.form.salon</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Salon" name="page_salon">
                    <group>
                        <group>
                            <field name="salon_gender"/>
                            <field name="salon_birthdate"/>
                            <field name="salon_preferred_employee_id"/>
                            <field name="salon_preferred_service_ids" widget="many2many_tags"/>
                        </group>
                        <group groups="salon_management.group_salon_receptionist">
                            <field name="salon_customer_status"/>
                            <field name="salon_visit_count"/>
                            <field name="salon_last_visit"/>
                            <field name="salon_total_spent"/>
                            <field name="salon_cancel_count"/>
                            <field name="salon_noshow_count"/>
                        </group>
                    </group>
                    <field name="salon_notes" placeholder="Salon notes (allergies, preferences)..."/>
                    <field name="salon_booking_ids" readonly="1" groups="salon_management.group_salon_receptionist">
                        <list>
                            <field name="name"/>
                            <field name="start_datetime"/>
                            <field name="amount_untaxed"/>
                            <field name="payment_status"/>
                            <field name="state"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_search_salon" model="ir.ui.view">
        <field name="name">res.partner.search.salon</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Salon Customers" name="salon_customers" domain="[('salon_booking_ids', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_salon_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_salon_customers': 1}</field>
    </record>

    <!-- Staff -->
    <record id="view_employee_form_salon" model="ir.ui.view">
        <field name="name">hr.employee.form.salon</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Salon" name="page_salon" groups="salon_management.group_salon_manager">
                    <group>
                        <group string="Salon">
                            <field name="salon_is_staff"/>
                            <field name="salon_service_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Pay &amp; Commission">
                            <field name="salon_salary_type"/>
                            <field name="salon_fixed_salary" invisible="salon_salary_type not in ('fixed', 'fixed_commission')"/>
                            <field name="salon_daily_rate" invisible="salon_salary_type not in ('daily', 'daily_commission')"/>
                            <field name="salon_commission_type" invisible="salon_salary_type not in ('commission', 'fixed_commission', 'daily_commission')"/>
                            <field name="salon_commission_value" invisible="salon_salary_type not in ('commission', 'fixed_commission', 'daily_commission')"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_employee_search_salon" model="ir.ui.view">
        <field name="name">hr.employee.search.salon</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Salon Staff" name="salon_staff" domain="[('salon_is_staff', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_salon_staff" model="ir.actions.act_window">
        <field name="name">Staff</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_salon_staff': 1, 'default_salon_is_staff': True}</field>
    </record>

    <!-- Services -->
    <record id="view_product_template_form_salon" model="ir.ui.view">
        <field name="name">product.template.form.salon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Salon" name="page_salon">
                    <group>
                        <field name="is_salon_service"/>
                        <field name="salon_duration" widget="float_time" invisible="not is_salon_service"/>
                    </group>
                    <field name="salon_commission_rule_ids" invisible="not is_salon_service"
                           groups="salon_management.group_salon_manager">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="method"/>
                            <field name="value"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_salon_services" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_salon_service', '=', True)]</field>
        <field name="context">{'default_is_salon_service': True, 'default_type': 'service'}</field>
    </record>

    <!-- Commission rules -->
    <record id="view_salon_commission_rule_list" model="ir.ui.view">
        <field name="name">salon.commission.rule.list</field>
        <field name="model">salon.commission.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="product_tmpl_id"/>
                <field name="method"/>
                <field name="value"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_salon_commission_rule" model="ir.actions.act_window">
        <field name="name">Commission Rules</field>
        <field name="res_model">salon.commission.rule</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Discount limits (per company) -->
    <record id="view_company_form_salon" model="ir.ui.view">
        <field name="name">res.company.form.salon</field>
        <field name="model">res.company</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Salon Settings">
                <sheet>
                    <h2><field name="name" readonly="1"/></h2>
                    <group string="Discount limits">
                        <field name="salon_staff_max_discount"/>
                        <field name="salon_manager_max_discount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_salon_settings" model="ir.actions.act_window">
        <field name="name">Discount Limits</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_salon_settings_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_salon_settings"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_company_form_salon"/>
        <field name="sequence">2</field>
    </record>
</odoo>
