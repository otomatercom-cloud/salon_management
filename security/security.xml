<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_salon" model="res.groups.privilege">
        <field name="name">Salon Management</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_salon_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_salon"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_salon_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_salon"/>
        <field name="implied_ids" eval="[Command.link(ref('group_salon_staff')), Command.link(ref('account.group_account_invoice')), Command.link(ref('base.group_partner_manager'))]"/>
    </record>
    <record id="group_salon_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_salon"/>
        <field name="implied_ids" eval="[Command.link(ref('group_salon_receptionist')), Command.link(ref('product.group_product_manager'))]"/>
    </record>
    <record id="group_salon_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_salon"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('account.group_account_readonly'))]"/>
    </record>
    <record id="group_salon_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_salon"/>
        <field name="implied_ids" eval="[Command.link(ref('group_salon_manager')), Command.link(ref('group_salon_accountant'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <!-- multi-company -->
        <record id="rule_booking_company" model="ir.rule">
            <field name="name">Salon booking: multi-company</field>
            <field name="model_id" ref="model_salon_booking"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_booking_line_company" model="ir.rule">
            <field name="name">Salon booking line: multi-company</field>
            <field name="model_id" ref="model_salon_booking_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_commission_rule_company" model="ir.rule">
            <field name="name">Salon commission rule: multi-company</field>
            <field name="model_id" ref="model_salon_commission_rule"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_payout_company" model="ir.rule">
            <field name="name">Salon payout: multi-company</field>
            <field name="model_id" ref="model_salon_staff_payout"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_expense_company" model="ir.rule">
            <field name="name">Salon expense: multi-company</field>
            <field name="model_id" ref="model_salon_expense"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- staff see only their own bookings; receptionist and up see all -->
        <record id="rule_booking_staff" model="ir.rule">
            <field name="name">Salon booking: staff see own</field>
            <field name="model_id" ref="model_salon_booking"/>
            <field name="groups" eval="[Command.link(ref('group_salon_staff'))]"/>
            <field name="domain_force">['|', ('line_ids.employee_id.user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        </record>
        <record id="rule_booking_all" model="ir.rule">
            <field name="name">Salon booking: receptionist/accountant see all</field>
            <field name="model_id" ref="model_salon_booking"/>
            <field name="groups" eval="[Command.link(ref('group_salon_receptionist')), Command.link(ref('group_salon_accountant'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_booking_line_staff" model="ir.rule">
            <field name="name">Salon booking line: staff see own</field>
            <field name="model_id" ref="model_salon_booking_line"/>
            <field name="groups" eval="[Command.link(ref('group_salon_staff'))]"/>
            <field name="domain_force">['|', ('booking_id.line_ids.employee_id.user_id', '=', user.id), ('booking_id.create_uid', '=', user.id)]</field>
        </record>
        <record id="rule_booking_line_all" model="ir.rule">
            <field name="name">Salon booking line: receptionist/accountant see all</field>
            <field name="model_id" ref="model_salon_booking_line"/>
            <field name="groups" eval="[Command.link(ref('group_salon_receptionist')), Command.link(ref('group_salon_accountant'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
