<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salon_booking_reason_wizard_form" model="ir.ui.view">
        <field name="name">salon.booking.reason.wizard.form</field>
        <field name="model">salon.booking.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason">
                <group>
                    <field name="booking_id" invisible="1"/>
                    <field name="mode" invisible="1"/>
                    <field name="reason" required="mode == 'cancel'"/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
